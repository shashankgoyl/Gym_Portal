# Copy this file to .env and fill in what you need. Every value below is
# optional — HP runs with zero configuration out of the box.

# Enables the Gemini-powered health assistant and PDF report explanations.
# Get a key from Google AI Studio. Without it, the assistant stays in a
# clear "not configured" state and everything else keeps working.
# GEMINI_API_KEY=

# Override the local port (default: 3000, auto-increments if busy).
# PORT=3000

# Where the local SQLite database file lives. Defaults to ./data/hp.db.
# DATABASE_URL=./data/hp.db

# Where uploaded health-report PDFs are stored. Defaults to ./data/uploads.
# UPLOADS_DIR=./data/uploads
